{
  "name": "korean-learning-app",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @korean-learning/web dev",
    "build": "pnpm --filter @korean-learning/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @korean-learning/web test:e2e",
    "test:a11y": "pnpm --filter @korean-learning/web test:a11y",
    "test:visual": "pnpm --filter @korean-learning/web test:visual"
  }
}
